{
  "mcpServers": {
    "prisma": {
      "command": "npx",
      "args": ["-y", "prisma-mcp-server@latest"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server@latest"],
      "env": {
        "PROJECT_ROOT": "."
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
