{
  "production-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/safety_gate.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
